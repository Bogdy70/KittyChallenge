# Serverul Node citește variabilele mediului; Docker Compose citește acest fișier după copiere ca .env.
PORT=3001
HOST=127.0.0.1
# true când aplicația este servită prin HTTPS
COOKIE_SECURE=false

# Doar pentru publicarea portului Docker; pentru Node/Vite folosește configure:network.
KITTY_BIND_ADDRESS=127.0.0.1
# NETWORK_FILE=config/network.json

# Opțional: generare ElevenLabs. Poți configura cheia și din Atelier → Vocea.
# ELEVENLABS_API_KEY=
# VOICE_SECRETS_FILE=config/voice-secrets.json
